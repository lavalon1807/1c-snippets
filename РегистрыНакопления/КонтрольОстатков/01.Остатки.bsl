Функция ЕстьОтрицательныеОстатки(Ссылка, Дата, Склад) Экспорт

    ГраницаДо = Новый Граница(Дата, ВидГраницы.Исключая);

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |   Остатки.Номенклатура КАК Номенклатура,
        |   Остатки.КоличествоОстаток КАК КоличествоОстаток
        |ИЗ
        |   РегистрНакопления.ОстаткиТоваров.Остатки(
        |       &Дата,
        |       Склад = &СкладОтбора
        |           И Номенклатура В
        |               (ВЫБРАТЬ
        |                   РасходТовараТовары.Номенклатура КАК Номенклатура
        |               ИЗ
        |                   Документ.РасходТовара.Товары КАК РасходТовараТовары
        |               ГДЕ
        |                   РасходТовараТовары.Ссылка = &Ссылка)) КАК Остатки";

    Запрос.УстановитьПараметр("Дата", ГраницаДо);
    Запрос.УстановитьПараметр("СкладОтбора", Склад);
    Запрос.УстановитьПараметр("Ссылка", Ссылка);

    // Остатки "до" в соответствие: Номенклатура → Количество
    ОстаткиДо = Новый Соответствие;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ОстаткиДо.Вставить(Выборка.Номенклатура, Выборка.КоличествоОстаток);
    КонецЦикла;

    // Считаем "после" по табличной части документа
    ЕстьОтрицательные = Ложь;
    ДокументОбъект = Ссылка.ПолучитьОбъект();
    Для Каждого СтрокаТЧ Из ДокументОбъект.Товары Цикл
        КоличествоДо = ОстаткиДо[СтрокаТЧ.Номенклатура];
        Если КоличествоДо = Неопределено Тогда
            КоличествоДо = 0;
        КонецЕсли;

        КоличествоПосле = КоличествоДо - СтрокаТЧ.Количество; // расход

        Если КоличествоПосле < 0 Тогда
            ЕстьОтрицательные = Истина;
            Сообщить(СтрШаблон(
                "Не хватает товара ""%1"" на складе ""%2"": требуется %3, в наличии %4",
                СтрокаТЧ.Номенклатура, Склад, СтрокаТЧ.Количество, КоличествоДо));
        КонецЕсли;
    КонецЦикла;

    Возврат ЕстьОтрицательные;

КонецФункции